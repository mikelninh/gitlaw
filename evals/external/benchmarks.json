{
  "schema_version": "1.0",
  "principle": "External benchmark scores are comparable evidence for the capability they measure, not proof of German-law or law-firm production readiness.",
  "benchmarks": [
    {
      "id": "legalbench-rag",
      "name": "LegalBench-RAG",
      "upstream_repo": "zeroentropy-ai/legalbenchrag",
      "upstream_commit": "431bc8f2488a81569ab7259fa633dcc50ab77f9a",
      "paper": "arXiv:2408.10343",
      "reported_examples": 6858,
      "primary_layer": "retrieval",
      "domain": "English legal contracts / privacy / M&A / NDA retrieval",
      "metrics": ["precision", "recall", "character_level_precision", "character_level_recall"],
      "code_license": "MIT",
      "data_license_policy": "INHERITED_PER_SOURCE_DATASET",
      "data_sources": ["ContractNLI", "CUAD", "MAUD", "PrivacyQA"],
      "gitlaw_claim_scope": "external_retrieval_comparability_only",
      "counts_for_german_legal_release_gate": false,
      "allowed_ci_mode": "adapter_and_license_contract",
      "notes": "Do not vendor or redistribute source-derived benchmark data without satisfying each upstream dataset's terms."
    },
    {
      "id": "legalbench",
      "name": "LegalBench",
      "upstream_repo": "HazyResearch/legalbench",
      "upstream_commit": "b46bf4ffae90524b2b72aaa30e7745fe9db64481",
      "paper": "arXiv:2308.11462",
      "reported_tasks": 162,
      "reported_contributors": 40,
      "primary_layer": "legal_reasoning",
      "domain": "English legal reasoning tasks across multiple jurisdictions and task families",
      "metrics": ["task_specific_accuracy", "f1", "generation_metrics"],
      "code_or_collection_license": "MIXED_PER_TASK",
      "data_license_policy": "FOLLOW_EACH_TASK_LICENSE",
      "gitlaw_claim_scope": "external_reasoning_comparability_only",
      "counts_for_german_legal_release_gate": false,
      "allowed_ci_mode": "task_inventory_and_license_contract",
      "notes": "Select only tasks whose license is explicitly compatible; a LegalBench score is not a German-law accuracy score."
    },
    {
      "id": "legal-rag-bench",
      "name": "Legal RAG Bench",
      "upstream_repo": "isaacus-dev/legal-rag-bench",
      "upstream_commit": "9e30a36d1ef58cd35ec4ed724ef3e5edc6b0d00b",
      "dataset": "isaacus/legal-rag-bench",
      "paper": "arXiv:2603.01710",
      "reported_questions": 100,
      "reported_passages": 4876,
      "primary_layer": "end_to_end_rag_error_decomposition",
      "domain": "Victorian criminal law and procedure",
      "metrics": ["retrieval_hit_at_k", "correctness", "groundedness", "oracle_vs_retrieved_gap"],
      "code_license": "MIT",
      "gitlaw_claim_scope": "retrieval_vs_reasoning_decomposition_only",
      "counts_for_german_legal_release_gate": false,
      "allowed_ci_mode": "oracle_decomposition_contract",
      "notes": "Use the factorial/oracle methodology to attribute failures. Do not present Australian-law performance as German-law performance."
    }
  ],
  "gitlaw_specific_layers": {
    "german_gold": {
      "required": true,
      "target_lawyer_reviewed_cases": 500,
      "frozen_holdout_cases": 200,
      "minimum_distinct_task_families": 12,
      "may_use_public_case_candidates_before_review": true,
      "unreviewed_candidates_count_as_gold": false
    },
    "law_firm_matters": {
      "required": true,
      "target_shadow_matters": 100,
      "minimum_independent_lawyer_reviewers": 5,
      "must_measure": ["material_correction_rate", "time_to_review_ready", "critical_issue_miss_rate", "trust_calibration"]
    }
  }
}
